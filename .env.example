# Copy to .env and adjust. Never commit .env.
DATABASE_PATH=./data/ruchintachi.db

# Local testing only: set to true to skip sign-in under `pnpm dev`.
# Every visitor without a session becomes the "dev" user (password
# "dev-password"), created on first use. Ignored by `pnpm build` /
# `pnpm start`, so it can't apply on the server.
DEV_AUTO_SIGNIN=false

# Features still being built. Leave unset on the deployed server so they
# stay hidden; set to true locally to work on them.
FEATURE_TOWN=true
