# Ruchintachi Next.js app (issue #22). Starts on boot, restarts on crash.
# Runs the standalone build that deploy.sh unpacked; `current` points at it.
[Unit]
Description=Ruchintachi habit tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ruchintachi
Group=ruchintachi
WorkingDirectory=/opt/ruchintachi/current
EnvironmentFile=/etc/ruchintachi.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ruchintachi /opt/ruchintachi/releases

[Install]
WantedBy=multi-user.target
