# Ruchintachi Next.js app (issue #22). Starts on boot, restarts on crash.
[Unit]
Description=Ruchintachi habit tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ruchintachi
Group=ruchintachi
WorkingDirectory=/opt/ruchintachi
EnvironmentFile=/etc/ruchintachi.env
ExecStart=/opt/ruchintachi/node_modules/.bin/next start --port ${PORT} --hostname ${HOSTNAME}
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ruchintachi /opt/ruchintachi/.next

[Install]
WantedBy=multi-user.target
